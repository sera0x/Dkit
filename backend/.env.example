# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection (host/user/database default to dkituser/localhost/dkit
# if omitted — only the password is required)
DB_PASSWORD=
# DB_USER=dkituser
# DB_HOST=localhost
# DB_NAME=dkit
# DB_PORT=5432

# Used to sign login JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=

# Resend API key for sending verification/login-code emails
RESEND_API_KEY=

# Optional — image/file CDN on Cloudflare R2. Without these, media uploads
# return a clear 501 and everything else keeps working. Reuse the backup keys
# or make scoped ones in the dashboard (R2 → Manage API tokens).
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=dkit-cdn
# Optional public base (e.g. https://cdn.your-domain.ng) — when set, permanent
# files redirect there and Cloudflare serves them without touching your box.
# R2_PUBLIC_BASE=
# Max upload size in bytes (default 15 MB)
# MEDIA_MAX_BYTES=15728640

# Set to 1 when running a second dev instance against a live DB — skips the
# cron/monitor/media job runner so ticks don't double-fire.
# DKIT_DISABLE_JOBS=1

# Cache KV (Redis): max value size in bytes (default 128 KB) and requests per
# minute per API key (default 1200). Redis itself is capped at 64 MB with
# allkeys-lru in redis.conf — it is a cache, never the only copy of data.
# KV_MAX_BYTES=131072
# KV_RATE_LIMIT=1200

# Port the API listens on (ecosystem.config.js already sets this to 3001)
# PORT=3001

# Your real, public-facing origin (no trailing slash) — used to build OAuth
# redirect URIs, invite links and password-reset links. Defaults to
# http://localhost:3001 when omitted.
# PUBLIC_URL=https://your-domain.example

# OAuth — optional. Buttons only appear once both ID+secret are set for a
# given provider; leave blank to keep that provider hidden.
# Google: console.cloud.google.com -> APIs & Services -> Credentials
#   Authorized redirect URI: {PUBLIC_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: github.com/settings/developers -> OAuth Apps -> New
#   Authorization callback URL: {PUBLIC_URL}/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
